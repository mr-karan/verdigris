{
  "name": "Verdigris",
  "version": "0.1.0",
  "description": "Weathered stone and patinated copper. A calm colour theme in a light and a dark flavour.",
  "author": "Karan Sharma",
  "license": "MIT",
  "homepage": "https://github.com/mr-karan/verdigris",
  "flavours": {
    "limestone": {
      "name": "Limestone",
      "appearance": "light",
      "colors": {
        "bg_dim": "#ebece6",
        "bg": "#f3f3ee",
        "bg_raised": "#fbfbf8",
        "fill_soft": "#ecede7",
        "fill": "#e6e8e1",
        "line": "#dddfd7",
        "line_strong": "#cdd0c7",
        "fg_faint": "#b7bbb1",
        "fg_subtle": "#6f7975",
        "fg_muted": "#5c6763",
        "fg": "#252d2a",
        "fg_strong": "#1e2523",
        "patina": "#2c6e64",
        "copper": "#8f5226",
        "cuprite": "#a8423f",
        "azurite": "#3d628a",
        "malachite": "#496c35",
        "brass": "#76611b",
        "bornite": "#785480",
        "patina_bright": "#195e55",
        "cuprite_bright": "#963130",
        "azurite_bright": "#2e5279",
        "malachite_bright": "#3a5c26",
        "brass_bright": "#665102",
        "bornite_bright": "#684570",
        "patina_wash": "#dcebe6",
        "copper_wash": "#f4e9db",
        "cuprite_wash": "#f5e5e1",
        "azurite_wash": "#e3eaf1",
        "malachite_wash": "#deebd8",
        "selection": "#cde0d9",
        "search": "#f0d9bb"
      }
    },
    "slate": {
      "name": "Slate",
      "appearance": "dark",
      "colors": {
        "bg_dim": "#111615",
        "bg": "#151a19",
        "bg_raised": "#1e2524",
        "fill_soft": "#1b2120",
        "fill": "#222a28",
        "line": "#29312f",
        "line_strong": "#323b39",
        "fg_faint": "#3a4543",
        "fg_subtle": "#75827d",
        "fg_muted": "#8e9a96",
        "fg": "#d0d7d3",
        "fg_strong": "#dde3df",
        "patina": "#82c3b4",
        "copper": "#d9a377",
        "cuprite": "#e38d86",
        "azurite": "#8fb2d8",
        "malachite": "#a3c18d",
        "brass": "#cabf7f",
        "bornite": "#c0a1c9",
        "patina_bright": "#95d6c7",
        "cuprite_bright": "#f8a098",
        "azurite_bright": "#a2c5ec",
        "malachite_bright": "#b6d4a0",
        "brass_bright": "#ded392",
        "bornite_bright": "#d3b4dd",
        "patina_wash": "#1a2d29",
        "copper_wash": "#2c231a",
        "cuprite_wash": "#2e1c1a",
        "azurite_wash": "#1a2530",
        "malachite_wash": "#202b1d",
        "selection": "#26403a",
        "search": "#523a24"
      }
    }
  },
  "notes": {
    "bg_dim": "Sidebars, status and tab bars, inset code. ANSI black.",
    "bg": "Editor and terminal background.",
    "bg_raised": "Menus, popups and floating windows.",
    "fill_soft": "Cursor line and quiet hover.",
    "fill": "Hover, inactive selection, chips.",
    "line": "Borders and rules.",
    "line_strong": "Input borders, indent guides, scrollbars.",
    "fg_faint": "Whitespace markers and disabled text.",
    "fg_subtle": "Comments, line numbers, ANSI bright black.",
    "fg_muted": "Secondary text, operators, punctuation.",
    "fg": "Code and terminal text. ANSI white.",
    "fg_strong": "Headings and emphasis. ANSI bright white.",
    "patina": "The accent: keywords, cursor, focus, links. ANSI cyan.",
    "copper": "The one warm note: numbers, constants, warnings, search.",
    "cuprite": "Errors and deletions. ANSI red.",
    "azurite": "Functions, information, changes. ANSI blue.",
    "malachite": "Strings, additions, success. ANSI green.",
    "brass": "Types, attributes, escapes. ANSI yellow.",
    "bornite": "Decorators, self and this. ANSI magenta.",
    "patina_bright": "ANSI bright cyan.",
    "cuprite_bright": "ANSI bright red.",
    "azurite_bright": "ANSI bright blue.",
    "malachite_bright": "ANSI bright green.",
    "brass_bright": "ANSI bright yellow.",
    "bornite_bright": "ANSI bright magenta.",
    "patina_wash": "Accent surfaces and hints.",
    "copper_wash": "Warning surfaces.",
    "cuprite_wash": "Error surfaces and removed lines.",
    "azurite_wash": "Information surfaces and changed lines.",
    "malachite_wash": "Added lines.",
    "selection": "Selected text.",
    "search": "Search matches."
  },
  "roles": {
    "terminal": {
      "background": "bg",
      "foreground": "fg",
      "cursor": "patina",
      "cursor_text": "bg",
      "selection_background": "selection",
      "selection_foreground": "fg"
    },
    "ansi": {
      "black": "bg_dim",
      "red": "cuprite",
      "green": "malachite",
      "yellow": "brass",
      "blue": "azurite",
      "magenta": "bornite",
      "cyan": "patina",
      "white": "fg",
      "bright_black": "fg_subtle",
      "bright_red": "cuprite_bright",
      "bright_green": "malachite_bright",
      "bright_yellow": "brass_bright",
      "bright_blue": "azurite_bright",
      "bright_magenta": "bornite_bright",
      "bright_cyan": "patina_bright",
      "bright_white": "fg_strong"
    },
    "semantic": {
      "error": "cuprite",
      "warning": "copper",
      "info": "azurite",
      "hint": "patina",
      "success": "malachite",
      "added": "malachite",
      "modified": "azurite",
      "removed": "cuprite"
    },
    "syntax": {
      "comment": { "color": "fg_subtle", "style": "italic" },
      "keyword": { "color": "patina" },
      "operator": { "color": "fg_muted" },
      "punctuation": { "color": "fg_muted" },
      "function": { "color": "azurite" },
      "string": { "color": "malachite" },
      "escape": { "color": "brass" },
      "regex": { "color": "brass" },
      "number": { "color": "copper" },
      "constant": { "color": "copper" },
      "type": { "color": "brass" },
      "variable": { "color": "fg" },
      "parameter": { "color": "fg" },
      "property": { "color": "fg" },
      "key": { "color": "azurite" },
      "namespace": { "color": "fg" },
      "tag": { "color": "patina" },
      "attribute": { "color": "brass" },
      "decorator": { "color": "bornite" },
      "builtin": { "color": "bornite", "style": "italic" },
      "label": { "color": "bornite" },
      "heading": { "color": "patina", "style": "bold" },
      "link": { "color": "azurite", "style": "underline" }
    }
  }
}
