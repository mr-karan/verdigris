[delta "verdigris-limestone"]
	light = true
	syntax-theme = verdigris-limestone
	minus-style = syntax "#f5e5e1"
	minus-emph-style = syntax "#e9cbc7"
	plus-style = syntax "#deebd8"
	plus-emph-style = syntax "#c6d7be"
	line-numbers-minus-style = "#a8423f"
	line-numbers-plus-style = "#496c35"
	line-numbers-zero-style = "#6f7975"
	line-numbers-left-style = "#dddfd7"
	line-numbers-right-style = "#dddfd7"
	file-style = "#1e2523" bold
	file-decoration-style = "#dddfd7" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#5c6763"
	hunk-header-line-number-style = "#8f5226"
	hunk-header-decoration-style = "#dddfd7" box
	commit-style = "#2c6e64" bold
	commit-decoration-style = "#dddfd7" ul
	blame-palette = "#f3f3ee" "#ebece6" "#ecede7" "#e6e8e1"
	merge-conflict-ours-diff-header-style = "#3d628a" bold
	merge-conflict-theirs-diff-header-style = "#785480" bold
	merge-conflict-begin-symbol = "~"
	merge-conflict-end-symbol = "~"

[delta "verdigris-slate"]
	dark = true
	syntax-theme = verdigris-slate
	minus-style = syntax "#2e1c1a"
	minus-emph-style = syntax "#4b2e2b"
	plus-style = syntax "#202b1d"
	plus-emph-style = syntax "#35432f"
	line-numbers-minus-style = "#e38d86"
	line-numbers-plus-style = "#a3c18d"
	line-numbers-zero-style = "#75827d"
	line-numbers-left-style = "#29312f"
	line-numbers-right-style = "#29312f"
	file-style = "#dde3df" bold
	file-decoration-style = "#29312f" ul
	hunk-header-style = file line-number syntax
	hunk-header-file-style = "#8e9a96"
	hunk-header-line-number-style = "#d9a377"
	hunk-header-decoration-style = "#29312f" box
	commit-style = "#82c3b4" bold
	commit-decoration-style = "#29312f" ul
	blame-palette = "#151a19" "#111615" "#1b2120" "#222a28"
	merge-conflict-ours-diff-header-style = "#8fb2d8" bold
	merge-conflict-theirs-diff-header-style = "#c0a1c9" bold
	merge-conflict-begin-symbol = "~"
	merge-conflict-end-symbol = "~"
